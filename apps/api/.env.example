# --- Aplicação ---
NODE_ENV=development
API_PORT=4000
# URL pública do frontend (usada em redirecionamentos e validação de Origin)
WEB_URL=http://localhost:3000
# URL pública desta API (usada para montar o redirect_uri do OAuth e a URL de webhook)
API_PUBLIC_URL=http://localhost:4000

DATABASE_URL=postgres://app:app@localhost:5432/converso
REDIS_URL=redis://localhost:6379

# Chave de 32 bytes em base64 para criptografar tokens (AES-256-GCM).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Dias de validade da sessão de login
SESSION_TTL_DAYS=30

# --- Meta / Instagram API com Login do Instagram ---
# Deixe em branco até ter um app da Meta configurado: a tela de Contas Conectadas
# mostrará que a integração não está disponível em vez de simular a conexão.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v24.0
# Permissões solicitadas no OAuth (separadas por vírgula)
META_SCOPES=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments
